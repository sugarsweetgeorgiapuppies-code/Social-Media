# ------------------------------------------------------------------
# Sugar Sweet Georgia Puppies — AI Social Media Employee
# Copy this file to `.env` and fill in the values.
# ------------------------------------------------------------------

# REQUIRED for real AI research + generation.
# Get a key at https://console.anthropic.com/ .
# Without it the app still runs end-to-end, but trends and ideas are
# produced by a clearly-labeled offline heuristic instead of live research.
ANTHROPIC_API_KEY=

# Claude model. Opus 4.8 is the default and recommended.
# Alternatives: claude-sonnet-5 (cheaper), claude-haiku-4-5 (fastest).
CLAUDE_MODEL=claude-opus-4-8

# Reasoning effort for generation calls: low | medium | high | xhigh | max
CLAUDE_EFFORT=high

# How many web searches the trend researcher may run per daily research pass.
TREND_SEARCH_MAX_USES=6

# SQLite database location (relative paths are fine).
DATABASE_URL=sqlite:///data/sugarsweet.db

# Web server
HOST=0.0.0.0
PORT=8000

# Scheduler: run automatic daily research + briefing at this local time (24h HH:MM).
# Leave DAILY_RUN_ENABLED=false to only run research manually from the dashboard.
DAILY_RUN_ENABLED=true
DAILY_RUN_TIME=07:00
TIMEZONE=America/New_York

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
