# ------------------------------------------------------------------
# Sugar Sweet Georgia Puppies — AI Social Media Employee
# Copy this file to `.env` and fill in the values.
# ------------------------------------------------------------------

# REQUIRED for real AI research + generation.
# Get a key at https://console.anthropic.com/ .
# Without it the app still runs end-to-end, but trends and ideas are
# produced by a clearly-labeled offline heuristic instead of live research.
ANTHROPIC_API_KEY=

# Claude model. Opus 4.8 is the default and recommended.
# Alternatives: claude-sonnet-5 (cheaper), claude-haiku-4-5 (fastest).
CLAUDE_MODEL=claude-opus-4-8

# Reasoning effort for generation calls: low | medium | high | xhigh | max
CLAUDE_EFFORT=high

# How many web searches the trend researcher may run per daily research pass.
TREND_SEARCH_MAX_USES=6

# SQLite database location (relative paths are fine).
DATABASE_URL=sqlite:///data/sugarsweet.db

# Web server
HOST=0.0.0.0
PORT=8000

# Scheduler: run automatic daily research + briefing at this local time (24h HH:MM).
# Leave DAILY_RUN_ENABLED=false to only run research manually from the dashboard.
DAILY_RUN_ENABLED=true
DAILY_RUN_TIME=07:00
TIMEZONE=America/New_York

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# Lead & Floor Board (wall-mounted showroom TV display at /board)
# ------------------------------------------------------------------
# The board polls ONE JSON feed. An n8n workflow builds that feed from your
# GoHighLevel pipeline stages — the board never talks to GoHighLevel directly
# and holds no credentials. The URL below is fetched server-side (proxied) so
# the browser never sees it and there are no CORS issues.
#
# Leave BOARD_FEED_URL blank to run in dev mode off a seeded, self-aging mock
# feed (great for watching cards age through every color before wiring n8n).
BOARD_FEED_URL=

# Force dev/mock mode on or off explicitly. If unset, dev mode is ON whenever
# BOARD_FEED_URL is blank and OFF once you set a real feed URL.
# BOARD_DEV_MODE=true

# Store name shown in the board header (defaults to the business name above).
# BOARD_STORE_NAME=Sugar Sweet Georgia Puppies

# Access PIN for the wall display. When set, the board asks for this PIN once
# per device and remembers it (cookie). Leave blank to keep the board open.
# BOARD_PIN=1848

# --- Direct GoHighLevel mode (recommended: no n8n, no execution limits) ------
# Set these and the board's own backend fetches GoHighLevel directly, so n8n
# runs ZERO executions. The token stays on this server; the browser never sees
# it. Get the token from GoHighLevel > Settings > Private Integrations (needs
# View Opportunities / Users / Calendars scopes).
BOARD_GHL_TOKEN=
BOARD_GHL_LOCATION_ID=
BOARD_GHL_CALENDAR_ID=
# Pipeline whose pre-appointment stages feed "New Inquiries".
BOARD_GHL_PIPELINE=General Inquiry
# Reuse a fetched GHL result for this many seconds (protects the API).
BOARD_GHL_CACHE_SECONDS=30

# How often the board re-polls the feed, in seconds. 60 is plenty for a wall
# display (the on-screen timers still tick every second on their own).
BOARD_POLL_SECONDS=60

# No successful poll within this many seconds => "connection lost" indicator.
BOARD_STALE_SECONDS=90

# Seconds to wait on the upstream feed before treating a poll as failed.
BOARD_FEED_TIMEOUT=10
